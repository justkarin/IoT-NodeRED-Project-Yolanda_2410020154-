    {
        "id": "store_sensor",
        "type": "function",
        "z": "7dd194724fa18d4e",
        "name": "Simpan Data Sensor",
        "func": "// Simpan ke context global\nvar data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// Simpan history (max 50 data)\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) {\n    history.shift();\n}\nflow.set('history', history);\n\nreturn msg;",
        "outputs": 1,
        "x": 390,
        "y": 60,
        "wires": [
            [
                "debug_sensor"
            ]
        ]
    },
